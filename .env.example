# Turso Cloud SQLite Configuration (Used by Vercel Serverless & optional locally)
# 1. Create a database on https://turso.tech
# 2. Paste these two variables in your Vercel Project Settings -> Environment Variables
TURSO_DATABASE_URL=libsql://festivalbuddy-yourname.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here
